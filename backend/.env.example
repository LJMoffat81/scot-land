W3W_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_VERCEL_PREVIEWS=true
PORT=8000

# Data root (config/, processed/, raw/). Defaults to the repo data/ directory.
# DATA_DIR=/app/data

# Wealth Engine database (PostGIS). No defaults for credentials.
# docker compose reads POSTGRES_* from a .env beside the compose file and
# builds DATABASE_URL for the api service itself. Use a URL-safe password.
POSTGRES_USER=scotland
POSTGRES_PASSWORD=
POSTGRES_DB=scotland_wealth
# Running uvicorn on the host instead: set ONE of
# DATABASE_URL=postgresql://scotland:<password>@127.0.0.1:5432/scotland_wealth
# or PGHOST / PGPORT / PGUSER / PGPASSWORD / PGDATABASE
# DB_CONNECT_TIMEOUT=3

# Dev only: mount /internal/... (placeholders, mocks, diagnostics). Never on a public host.
# ENABLE_INTERNAL_ENDPOINTS=1
