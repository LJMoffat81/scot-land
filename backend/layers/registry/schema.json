{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scot-land.local/layers/registry/schema.json",
  "title": "LayerRegistryEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "geography",
    "clip",
    "unit",
    "licence",
    "attribution",
    "source",
    "geometry",
    "refresh",
    "serve",
    "zoom",
    "style",
    "legend",
    "lineage"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "geography": { "type": "string", "enum": ["scotland"] },
    "clip": {
      "type": "string",
      "enum": ["land", "sea", "land+sea", "none"]
    },
    "unit": {
      "type": "string",
      "enum": [
        "scotland",
        "council",
        "dz2022",
        "dz2011",
        "settlement",
        "parcel",
        "square3m",
        "point",
        "none"
      ]
    },
    "ladder_level": {
      "type": "string",
      "enum": [
        "scotland",
        "council",
        "iz2022",
        "dz2022",
        "settlement",
        "parcel",
        "square3m"
      ]
    },
    "nests": { "type": "boolean" },
    "default_on": { "type": "boolean" },
    "licence": {
      "type": "string",
      "enum": ["OGL-3.0", "NSTA-OGL", "ODbL-1.0", "CC-BY-4.0"]
    },
    "attribution": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "arcgis",
            "wfs",
            "geojson_file",
            "postgis_table",
            "os_boundary_line"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "table": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)?$"
        },
        "id_field": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "where": { "type": "string" },
        "out_fields": { "type": "string" },
        "page_size": { "type": "integer", "minimum": 1 },
        "token_env": {
          "type": "string",
          "pattern": "^[A-Z_]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "layer": { "type": "string", "minLength": 1 },
        "code_field": { "type": "string", "minLength": 1 },
        "name_field": { "type": "string", "minLength": 1 },
        "code_prefix": { "type": "string", "minLength": 1 },
        "expected_count": { "type": "integer", "minimum": 1 },
        "download_max_mb": { "type": "number", "minimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "postgis_table" } },
            "required": ["type"]
          },
          "then": {
            "required": ["table", "id_field", "where"]
          },
          "else": {
            "required": ["url"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "os_boundary_line" } },
            "required": ["type"]
          },
          "then": {
            "required": [
              "url",
              "sha256",
              "layer",
              "code_field",
              "name_field",
              "code_prefix",
              "expected_count",
              "download_max_mb"
            ]
          },
          "else": {
            "properties": {
              "sha256": false,
              "layer": false,
              "code_field": false,
              "name_field": false,
              "code_prefix": false,
              "expected_count": false,
              "download_max_mb": false
            }
          }
        }
      ]
    },
    "geometry": {
      "type": "string",
      "enum": ["point", "line", "polygon"]
    },
    "refresh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cron", "max_mb", "max_s"],
      "properties": {
        "cron": { "type": "string", "minLength": 1 },
        "max_mb": { "type": "number", "minimum": 0 },
        "max_s": { "type": "number", "minimum": 0 }
      }
    },
    "serve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "simplify_m", "precision_dp", "max_mb"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["geojson", "pmtiles", "raster"]
        },
        "simplify_m": { "type": "number", "minimum": 0 },
        "display_note": { "type": "string", "minLength": 1, "maxLength": 200 },
        "precision_dp": {
          "type": "integer",
          "minimum": 4,
          "maximum": 7
        },
        "max_mb": {
          "type": "number",
          "minimum": 0,
          "maximum": 15
        }
      }
    },
    "zoom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "low_zoom"],
      "properties": {
        "min": { "type": "integer", "const": 0 },
        "max": { "type": "integer", "minimum": 0, "maximum": 16 },
        "low_zoom": {
          "type": "string",
          "enum": [
            "keep_all",
            "simplify",
            "coalesce",
            "cluster",
            "aggregate:council",
            "aggregate:dz2022"
          ]
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": { "type": "object" },
        "line": { "type": "object" },
        "circle": { "type": "object" }
      }
    },
    "measure": {
      "type": "string",
      "enum": ["pop_density", "simd_decile"]
    },
    "legend": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "color"],
        "properties": {
          "label": { "type": "string" },
          "color": { "type": "string" }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derived_from", "method", "roll_up_to"],
      "properties": {
        "derived_from": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "method": {
          "type": "string",
          "enum": [
            "source",
            "sum",
            "mean",
            "area_weighted",
            "pop_weighted",
            "median_of_children"
          ]
        },
        "roll_up_to": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "scotland",
              "council",
              "dz2022",
              "dz2011",
              "parcel",
              "square3m",
              "point",
              "none"
            ]
          }
        }
      }
    },
    "gated_by": { "type": "string" },
    "clip_keep_all": { "type": "boolean" },
    "keep_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget"],
      "properties": {
        "no_tiny_polygon_reduction": {
          "type": "boolean"
        },
        "max_culled": {
          "type": "integer",
          "minimum": 0
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total_mb", "tile_kb", "z0_7_mb"],
          "properties": {
            "total_mb": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 200
            },
            "tile_kb": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "z0_7_mb": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 20
            }
          }
        }
      }
    },
    "vintage": {
      "type": "string",
      "minLength": 1
    },
    "policy_question": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["Q1", "Q2", "Q3", "Q4", "Q5", "Q6"] }
    },
    "shows": {
      "type": "string",
      "enum": [
        "land_rent",
        "unearned_uplift",
        "value_capture",
        "idle_land",
        "commons_rent",
        "natural_capital",
        "context"
      ]
    },
    "value_layer": { "type": "boolean" },
    "non_commercial": { "type": "boolean" },
    "net_of": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "overlaps_with": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "admission_gaps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["vintage"] }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "clip": { "const": "none" } },
        "required": ["clip"]
      },
      "then": {
        "properties": {
          "serve": {
            "properties": { "mode": { "const": "raster" } },
            "required": ["mode"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "geometry": { "const": "polygon" } },
        "required": ["geometry"]
      },
      "then": {
        "required": ["clip_keep_all"]
      }
    },
    {
      "if": {
        "properties": {
          "serve": {
            "properties": { "mode": { "const": "pmtiles" } },
            "required": ["mode"]
          }
        },
        "required": ["serve"]
      },
      "then": {
        "required": ["tiles"]
      }
    },
    {
      "if": {
        "required": ["tiles"]
      },
      "then": {
        "properties": {
          "serve": {
            "properties": { "mode": { "const": "pmtiles" } },
            "required": ["mode"]
          }
        },
        "required": ["serve"]
      }
    }
  ]
}
